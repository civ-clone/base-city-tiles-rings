{
  "name": "@civ-clone/base-city-tiles-rings",
  "version": "0.1.0",
  "description": "The tiles a city may work: every tile within a number of rings of its centre, by the world's own steps. The default 2 rings is the 19-tile hex on the hexagonal grid.",
  "repository": "git@github.com:civ-clone/base-city-tiles-rings.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@civ-clone/base-city-tiles-fat-cross": "^0.1.0",
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-terrain": "^0.1.4",
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/core-world": "^0.1.24"
  }
}
